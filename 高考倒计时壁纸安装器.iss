; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only.
#define MyAppName "高考倒计时壁纸"
#define MyAppVersion "2.1.2"
#define MyAppPublisher "FullDream"
#define MyAppURL "http://狂.cn"
#define MyAppExeName "壁纸修改.exe"
#define EscapeConstArgument(Value) StringChange(StringChange(StringChange(Value, "%", "%25"), ",", "%2c"), "}", "%7d")

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{10DFD51B-B60F-4234-A9E2-FBF104EE6BCE}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={cm:NameAndVersion,{#EscapeConstArgument(MyAppName)},{#EscapeConstArgument(MyAppVersion)}}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
; ========== 固定安装目录 ==========
DefaultDirName=C:\Program Files (x86)\高考倒计时壁纸
DisableDirPage=yes
UninstallDisplayIcon={app}\{#MyAppExeName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run on anything but x64compatible
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
OutputDir=C:\Users\sheng\Desktop
OutputBaseFilename=高考倒计时壁纸安装器
SolidCompression=yes
WizardStyle=modern dynamic
;许可协议文件
LicenseFile="C:\Users\sheng\Desktop\高考倒计时壁纸\声明.txt"

[Languages]
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Files]
Source: "C:\Users\sheng\Desktop\高考倒计时壁纸\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\sheng\Desktop\高考倒计时壁纸\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "C:\Users\sheng\Desktop\高考倒计时壁纸\高考倒计时壁纸.lnk"; DestDir: "{userstartup}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\(请勿删除)壁纸修改"; Filename: "{app}\{#MyAppExeName}"

[Code]
procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    MsgBox('安装完成！'#13#10#13#10 +
           '请重启电脑，才能正常生效。',
           mbInformation, MB_OK);
  end;
end;
